{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "ignoreMsiWithNoMutations": true,
    "logs": {
        "text": "runtime/infection/infection-log.txt",
        "stryker": {
            "report": "1.x"
        }
    },
    "minCoveredMsi": 50,
    "minMsi": 50,
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Bridge"
        ]
    },
    "testFramework": "testo",
    "tmpDir": "runtime",
    "timeout": 10
}
