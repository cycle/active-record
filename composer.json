{
    "name": "cycle/active-record",
    "description": "Provides a simple way to work with your database using Active Record pattern and Cycle ORM",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cycle",
        "orm",
        "cycle-orm",
        "active-record",
        "database",
        "model",
        "activerecord"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Andrij Orlenko",
            "email": "the@wayof.dev"
        }
    ],
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/active-record/issues",
        "source": "https://github.com/cycle/active-record",
        "security": "https://github.com/cycle/active-record/blob/1.x/.github/SECURITY.md"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.24",
        "cycle/orm": "^2.19",
        "cycle/transaction": "^1.1.1",
        "psr/container": "^2.0.2",
        "yiisoft/injector": "^1.2.2"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "buggregator/trap": "^1.20",
        "cycle/testing": "^0.1.2",
        "cycle/entity-behavior": "^1.8",
        "illuminate/support": "^12 || ^13",
        "llm/skills": "^1.20",
        "rector/rector": "^2.8",
        "roxblnfk/unpoly": "^1.8",
        "spiral/boot": "^3.18",
        "spiral/cycle-bridge": "^2.13",
        "testo/testo": "^0.10.60"
    },
    "suggest": {
        "spiral/cycle-bridge": "Provides integration with Spiral Framework",
        "wayofdev/laravel-cycle-orm-adapter": "Laravel adapter for Cycle ORM",
        "yiisoft/yii-cycle": "Yii Cycle ORM integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Cycle\\ActiveRecord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "ergebnis/composer-normalize": true,
            "llm/skills": true,
            "spiral/composer-publish-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        },
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "config-plugin": {
            "bootstrap": "src/Bridge/Yii3/yii-bootstrap.php"
        },
        "laravel": {
            "providers": [
                "Cycle\\ActiveRecord\\Bridge\\Laravel\\Providers\\ActiveRecordProvider"
            ]
        },
        "spiral": {
            "bootloaders": [
                "Cycle\\ActiveRecord\\Bridge\\Spiral\\Bootloader\\ActiveRecordBootloader"
            ]
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "db:down": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml down -v",
        "db:up": "docker compose -f vendor/cycle/testing/resources/docker/compose.yaml up -d --wait",
        "infect": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --configuration=infection.json --threads=max"
        ],
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0"
        ],
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml --show-info=true",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "refactor": "rector process --config=rector.php",
        "refactor:ci": "rector process --config=rector.php --dry-run --ansi",
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:sqlite": "testo --suite=Feature/SQLite --suite=Acceptance/SQLite --suite=Regression/SQLite",
        "test:mysql": "testo --suite=Feature/MySQL --suite=Acceptance/MySQL --suite=Regression/MySQL",
        "test:postgres": "testo --suite=Feature/Postgres --suite=Acceptance/Postgres --suite=Regression/Postgres",
        "test:sqlserver": "testo --suite=Feature/SQLServer --suite=Acceptance/SQLServer --suite=Regression/SQLServer",
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVERS=sqlite",
            "testo --coverage"
        ]
    },
    "scripts-descriptions": {
        "infect": "Run mutation testing with Infection (install it first: composer bin infection install)",
        "infect:ci": "Run mutation testing in CI: GitHub annotations and the MSI thresholds"
    }
}
