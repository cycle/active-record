{
    "name": "cycle/active-record",
    "description": "Provides a simple way to work with your database using Active Record pattern and Cycle ORM",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cycle",
        "orm",
        "cycle-orm",
        "active-record",
        "database",
        "model",
        "activerecord"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Andrij Orlenko",
            "email": "the@wayof.dev"
        }
    ],
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/active-record/issues",
        "source": "https://github.com/cycle/active-record",
        "security": "https://github.com/cycle/active-record/blob/master/.github/SECURITY.md"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.20",
        "cycle/orm": "^2.18",
        "cycle/transaction": "1.x-dev",
        "psr/container": "^2.0.2",
        "yiisoft/injector": "^1.2.1"
    },
    "require-dev": {
        "buggregator/trap": "^1.16",
        "cycle/entity-behavior": "^1.7.1",
        "ergebnis/phpunit-slow-test-detector": "^2.24",
        "fakerphp/faker": "^1.24.1",
        "illuminate/support": "^10.48 || ^11.51",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^10.5.63",
        "rector/rector": "^1.2.10",
        "infection/infection": ">=0.32.6",
        "spiral/boot": "^3.12",
        "spiral/code-style": "^2.3.1",
        "spiral/cycle-bridge": "^2.13",
        "spiral/framework": "^3.17",
        "spiral/logger": "^3.12",
        "spiral/testing": "^2.9",
        "ta-tikoma/phpunit-architecture-test": "^0.8.7",
        "vimeo/psalm": "^7@beta"
    },
    "suggest": {
        "spiral/cycle-bridge": "Provides integration with Spiral Framework",
        "wayofdev/laravel-cycle-orm-adapter": "Laravel adapter for Cycle ORM",
        "yiisoft/yii-cycle": "Yii Cycle ORM integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/cycle/transaction.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Cycle\\ActiveRecord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\App\\": "tests/app/",
            "Cycle\\Tests\\": "tests/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "spiral/composer-publish-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "config-plugin": {
            "bootstrap": "src/Bridge/Yii3/yii-bootstrap.php"
        },
        "laravel": {
            "providers": [
                "Cycle\\ActiveRecord\\Bridge\\Laravel\\Providers\\ActiveRecordProvider"
            ]
        },
        "spiral": {
            "bootloaders": [
                "Cycle\\ActiveRecord\\Bridge\\Spiral\\Bootloader\\ActiveRecordBootloader"
            ]
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection"
        ],
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --logger-github --ignore-msi-with-no-mutations --only-covered"
        ],
        "psalm": "psalm --show-info=true",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "refactor": "rector process --config=rector.php",
        "refactor:ci": "rector process --config=rector.php --dry-run --ansi",
        "test": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --color=always"
        ],
        "test:arch": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --color=always"
        ],
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=runtime/phpunit/logs/clover.xml --color=always"
        ],
        "test:mysql": [
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVER=mysql",
            "phpunit --color=always"
        ],
        "test:pgsql": [
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVER=pgsql",
            "phpunit --color=always"
        ],
        "test:sqlite": [
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVER=sqlite",
            "phpunit --color=always"
        ],
        "test:sqlserver": [
            "@putenv XDEBUG_MODE=coverage",
            "@putenv DB_DRIVER=sqlserver",
            "phpunit --color=always"
        ]
    }
}
