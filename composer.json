{
    "name": "cycle/active-record",
    "description": "Provides a simple way to work with your database using Active Record pattern and Cycle ORM",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "cycle",
        "orm",
        "cycle-orm",
        "active-record",
        "database",
        "model",
        "activerecord"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Andrij Orlenko",
            "email": "the@wayof.dev"
        }
    ],
    "homepage": "https://cycle-orm.dev",
    "support": {
        "issues": "https://github.com/cycle/active-record/issues",
        "source": "https://github.com/cycle/active-record",
        "security": "https://github.com/cycle/active-record/blob/master/.github/SECURITY.md"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/cycle"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cycle/database": "^2.20",
        "cycle/orm": "^2.18",
        "cycle/transaction": "^1.1",
        "psr/container": "^2.0.2",
        "yiisoft/injector": "^1.2.1"
    },
    "require-dev": {
        "cycle/entity-behavior": "^1.7.1",
        "illuminate/support": "^12 || ^13",
        "infection/infection": ">=0.32.6",
        "llm/skills": "^1.8",
        "rector/rector": "^1.2.10",
        "spiral/boot": "^3.12",
        "spiral/code-style": "^2.3.1",
        "spiral/cycle-bridge": "^2.13",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.26",
        "vimeo/psalm": "^7@beta"
    },
    "suggest": {
        "spiral/cycle-bridge": "Provides integration with Spiral Framework",
        "wayofdev/laravel-cycle-orm-adapter": "Laravel adapter for Cycle ORM",
        "yiisoft/yii-cycle": "Yii Cycle ORM integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Cycle\\ActiveRecord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "llm/skills": true,
            "spiral/composer-publish-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "config-plugin": {
            "bootstrap": "src/Bridge/Yii3/yii-bootstrap.php"
        },
        "laravel": {
            "providers": [
                "Cycle\\ActiveRecord\\Bridge\\Laravel\\Providers\\ActiveRecordProvider"
            ]
        },
        "spiral": {
            "bootloaders": [
                "Cycle\\ActiveRecord\\Bridge\\Spiral\\Bootloader\\ActiveRecordBootloader"
            ]
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection"
        ],
        "infect:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0 --min-msi=50"
        ],
        "psalm": "psalm --show-info=true",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "refactor": "rector process --config=rector.php",
        "refactor:ci": "rector process --config=rector.php --dry-run --ansi",
        "test": "testo",
        "test:unit": "testo --suite=Unit",
        "test:acceptance": "testo --suite=Acceptance",
        "test:no-driver": "testo --group=!driver",
        "test:sqlite": "testo --suite=Acceptance --group=driver-sqlite",
        "test:mysql": "testo --suite=Acceptance --group=driver-mysql",
        "test:pgsql": "testo --suite=Acceptance --group=driver-pgsql",
        "test:sqlserver": "testo --suite=Acceptance --group=driver-sqlserver",
        "test:cc": [
            "@putenv XDEBUG_MODE=coverage",
            "testo --coverage"
        ]
    }
}
